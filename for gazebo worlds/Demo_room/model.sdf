<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="demo_room">
    <static>true</static> <link name="room_link">
      
      <collision name="demo_room_collision">
        <geometry>
          <mesh>
            <uri>model://Demo_room/meshes/demo_room.glb</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="demo_room_visual">
        <geometry>
          <mesh>
            <uri>model://Demo_room/meshes/demo_room.glb</uri>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
  